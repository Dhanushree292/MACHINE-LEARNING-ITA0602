
import pandas as pd
import math
from collections import Counter

# Training dataset
data = {
    'Outlook': ['Sunny', 'Sunny', 'Overcast', 'Rain', 'Rain',
                'Rain', 'Overcast', 'Sunny', 'Sunny', 'Rain',
                'Sunny', 'Overcast', 'Overcast', 'Rain'],
    'Temperature': ['Hot', 'Hot', 'Hot', 'Mild', 'Cool',
                    'Cool', 'Cool', 'Mild', 'Cool', 'Mild',
                    'Mild', 'Mild', 'Hot', 'Mild'],
    'Humidity': ['High', 'High', 'High', 'High', 'Normal',
                 'Normal', 'Normal', 'High', 'Normal', 'Normal',
                 'Normal', 'High', 'Normal', 'High'],
    'Wind': ['Weak', 'Strong', 'Weak', 'Weak', 'Weak',
             'Strong', 'Strong', 'Weak', 'Weak', 'Weak',
             'Strong', 'Strong', 'Weak', 'Strong'],
    'Play': ['No', 'No', 'Yes', 'Yes', 'Yes', 'No',
             'Yes', 'No', 'Yes', 'Yes', 'Yes', 'Yes',
             'Yes', 'No']
}

df = pd.DataFrame(data)

def entropy(target):
    counts = Counter(target)
    total = len(target)
    return -sum((count / total) * math.log2(count / total)
                for count in counts.values())

def id3(data, target, features):
    if len(set(target)) == 1:
        return target.iloc[0]

    if not features:
        return target.mode()[0]

    base_entropy = entropy(target)
    gains = {}

    for feature in features:
        weighted_entropy = 0
        for value in data[feature].unique():
            subset = data[feature] == value
            weighted_entropy += (
                subset.sum() / len(data)
            ) * entropy(target[subset])

        gains[feature] = base_entropy - weighted_entropy

    best = max(gains, key=gains.get)
    tree = {best: {}}

    for value in data[best].unique():
        subset = data[best] == value
        sub_data = data.loc[subset]
        sub_target = target.loc[subset]
        remaining = [f for f in features if f != best]

        tree[best][value] = id3(
            sub_data, sub_target, remaining
        )

    return tree

features = list(df.columns[:-1])
tree = id3(df, df['Play'], features)

print("Decision Tree:")
print(tree)

def predict(tree, sample):
    if not isinstance(tree, dict):
        return tree

    feature = next(iter(tree))
    value = sample.get(feature)

    if value not in tree[feature]:
        return "Unknown"

    return predict(tree[feature][value], sample)

sample = {
    'Outlook': 'Sunny',
    'Temperature': 'Cool',
    'Humidity': 'High',
    'Wind': 'Strong'
}

print("\nNew Sample:", sample)
print("Classification:", predict(tree, sample))
